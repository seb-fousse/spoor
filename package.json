{
  "name": "spoor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first personal data tracker. You own your data.",
  "license": "MPL-2.0",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "desktop:dev": "pnpm --filter @spoor/desktop tauri dev",
    "desktop:build": "pnpm --filter @spoor/desktop tauri build",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2"
  }
}
